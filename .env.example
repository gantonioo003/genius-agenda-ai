# Copie este arquivo para .env. Nunca coloque credenciais reais neste exemplo.
APP_NAME="Genius Agenda AI"
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=info
DATABASE_PATH=data/agenda.db

# Caminhos dos arquivos privados. Nunca cole chaves ou tokens neste exemplo.
GOOGLE_CLIENT_FILE=secrets/google-calendar-client.json
GOOGLE_TOKEN_FILE=secrets/google-calendar-token.json
GOOGLE_CALENDAR_NAME="Genius Testes"
# Opcional: ID explícito do calendário. Vazio: descobre uma agenda de teste única.
GOOGLE_CALENDAR_ID=
