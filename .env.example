# Copie este arquivo para .env. Nunca coloque credenciais reais neste exemplo.
APP_NAME="Genius Agenda AI"
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=info
DATABASE_PATH=data/agenda.db

# Chave Bearer privada da API. Gere uma chave local; não coloque valor real aqui.
# Vazio mantém as rotas protegidas indisponíveis (503); /health continua público.
API_AUTH_TOKEN=

# Caminhos dos arquivos privados. Nunca cole chaves ou tokens neste exemplo.
GOOGLE_CLIENT_FILE=secrets/google-calendar-client.json
GOOGLE_TOKEN_FILE=secrets/google-calendar-token.json
GOOGLE_CALENDAR_NAME="Genius Testes"
# Opcional: ID explícito do calendário. Vazio: descobre uma agenda de teste única.
GOOGLE_CALENDAR_ID=

# Chave privada do 360dialog Sandbox para registrar callback e envios autorizados.
# O receptor de entrada usa um token proprio; esta chave nunca vai para exports.
D360_API_KEY=

# OpenAI Responses API; chave apenas no .env privado, nunca no Git.
# Usada somente quando LLM_PROVIDER=openai; não há fallback automático de provedor.
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=600
LLM_MAX_INPUT_CHARS=4000

# Memória mínima de consultas; banco privado, separado da agenda e do inbox.
CONVERSATION_DATABASE_PATH=data/agent-conversations.sqlite3
# Expiração por inatividade, entre 60 e 86400 segundos (padrão: 30 minutos).
CONVERSATION_TTL_SECONDS=1800

# Registro privado da execução de criações do agente; separado do contexto.
AGENT_CREATION_DATABASE_PATH=data/agent-creations.sqlite3

# Registro privado de edições/reagendamentos do agente; separado do contexto.
AGENT_UPDATE_DATABASE_PATH=data/agent-updates.sqlite3

# Registro privado de exclusões confirmadas do agente; separado do contexto.
AGENT_DELETION_DATABASE_PATH=data/agent-deletions.sqlite3

# Ativar somente após alinhar entrada/n8n; worker usa apenas o remetente autorizado.
WHATSAPP_AGENT_ENABLED=false
WHATSAPP_AGENT_DATABASE_PATH=data/whatsapp-agent.sqlite3
WHATSAPP_AGENT_OUTBOX_PATH=data/whatsapp-agent-outbox.sqlite3

# Provedor da IA do bot; a opção Gemini depende de projeto com faixa gratuita.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=2048

# Ativar após preparar o servidor HTTPS de cards (docs/cards-com-ia.md).
REMINDER_CARDS_ENABLED=false
