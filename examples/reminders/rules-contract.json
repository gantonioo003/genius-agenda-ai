{
  "contract_version": "reminder_rules_v1",
  "implementation_status": "planned_not_active",
  "source": {
    "name": "Desafio_Genius_Agenda_AI_Auto_Genius_BRANDED.docx",
    "example_offsets_minutes": [
      1440,
      60,
      15
    ],
    "intervals_are_configurable": true,
    "30_5_was_not_required": true
  },
  "scope": {
    "calendar": "explicit_authorized_calendar",
    "recipient": "exact_private_authorized_binding",
    "timed_events_only": true,
    "status": "confirmed",
    "recurrence": "expanded_occurrences_with_own_id_only",
    "configuration": "single_explicit_profile_no_event_override"
  },
  "default_slots": {
    "day_before": null,
    "preparation": 60,
    "imminent": 15
  },
  "configuration_rules": {
    "unit": "minutes",
    "integer_only": true,
    "minimum": 1,
    "maximum": 10080,
    "unique_enabled_offsets": true,
    "descending_slot_order": [
      "day_before",
      "preparation",
      "imminent"
    ],
    "all_disabled_allowed": true
  },
  "clock": {
    "comparison_zone": "UTC",
    "display_zone": "selected_calendar_IANA_zone",
    "elapsed_minutes": true
  },
  "delivery_window": {
    "grace_seconds": 120,
    "future_poll_interval_max_seconds": 60,
    "due_inclusive": true,
    "deadline_exclusive": true,
    "deadline": "min(due_utc+grace_seconds,start_utc)",
    "never_send_after_start": true,
    "retroactive_catchup": false
  },
  "semantic_identity": [
    "calendar_id",
    "exact_occurrence_event_id",
    "start_utc",
    "stable_slot",
    "authorized_recipient_binding"
  ],
  "not_identity": [
    "offset_minutes",
    "due_utc",
    "title",
    "etag",
    "policy_revision",
    "n8n_execution_id"
  ],
  "before_send": "revalidate_exact_event_and_channel",
  "unknown_send_policy": "retain_identity_block_blind_retry",
